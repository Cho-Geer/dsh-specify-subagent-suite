{
  "name": "@zach-tao/dsh-specify-subagent-suite",
  "version": "0.1.0",
  "description": "5 resident DSH plugins merged into one Cordis bundle: right Agent list, subagent template panel, one-shot subagent record badge, and the subagent_pro / subagent_pro_presets / subagent_pro_audit tools.",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "README.ja.md",
    "README.i18n.yaml",
    "LICENSE",
    "tests"
  ],
  "license": "MIT",
  "author": "zach_tao",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "subagent",
    "agent-preset",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cho-Geer/dsh-specify-subagent-suite.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "next"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "prepare": "tsdown"
  }
}
